# copy to docker/.env and fill in
POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
DASHLAB_SECRET=change-me-to-at-least-32-bytes-of-random
PUBLIC_URL=https://dash.nimbuscloud.au
TRUST_PROXY=true
TZ=Australia/Melbourne
# optional headless bootstrap of the first superuser:
# DASHLAB_SETUP_USERNAME=admin
# SETUP_PASSWORD=another-strong-password

# --- Integrations (P3, all optional) ---
# Beszel (machine stats)
# BESZEL_URL=http://beszel.local:8090
# BESZEL_EMAIL=you@example.com
# BESZEL_PASSWORD=...
# Uptime Kuma (needs one published status page containing your monitors)
# UPTIME_KUMA_URL=http://uptime.local:3001
# UPTIME_KUMA_STATUS_SLUG=homelab
# UPTIME_KUMA_API_KEY=            # optional, enables 30d uptime via /metrics
# OpenRouter (spend/usage) — management key from openrouter.ai/settings/management-keys
# OPENROUTER_MANAGEMENT_KEY=...
